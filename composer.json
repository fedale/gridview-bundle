{
    "name": "fedale/gridview-bundle",
    "description": "A reusable, application-grade data-grid component for Symfony.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "bundle",
        "gridview",
        "datagrid",
        "grid",
        "crud",
        "symfony-ux",
        "stimulus"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Danilo Di Moia",
            "email": "zitter@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.0 || ^8.0",
        "symfony/property-access": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "doctrine/orm": "^2.12 || ^3.0",
        "doctrine/doctrine-bundle": "^2.7 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/maker-bundle": "^1.50",
        "phpstan/phpstan": "^2.0",
        "symfony/intl": "^8.1",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "suggest": {
        "symfony/http-client": "Enables the built-in JsonDataProvider for grids backed by a JSON-over-HTTP endpoint instead of Doctrine",
        "symfony/mercure-bundle": "Enables real-time grid updates (signal + auto-refresh) over Mercure",
        "symfony/maker-bundle": "Enables the make:gv:crud scaffolding command. Install it in your app with: composer require --dev symfony/maker-bundle",
        "ext-intl": "Enables full ICU-based locale-aware number/date/currency formatting; a reduced fallback is used without it.",
        "symfony/intl": "Enables localized names for the country/language/locale/currency column types; the bare ISO code is shown without it."
    },
    "autoload": {
        "psr-4": {
            "Fedale\\GridviewBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedale\\GridviewBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}