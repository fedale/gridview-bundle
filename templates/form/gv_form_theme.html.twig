{#
  Bundle's own default form theme: adds gv-* class hooks (row/label/control/
  help/errors) to Symfony's stock form_div_layout.html.twig blocks so the CRUD
  form gets proper spacing/typography without depending on Bootstrap/Tailwind.
  Host forms may use it too (twig.form_themes), inside [data-gridview] or
  [data-gv-scope]: a checkbox with class gv-switch is drawn as a switch, an
  expanded choice with class gv-segmented as buttons side by side (_forms.scss),
  a media control showing its files draws them (gv_media, gv_media_list), and a
  collection control its repeatable rows (gv_collection).
  Applied automatically unless a host overrides `form.theme` in its grid
  controller's viewConfig() (see AbstractCrudGridController::defaultConfig()).
#}
{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_class = 'gv-form-row' -%}
    {#- A checkbox drawn as a switch keeps its label first: gv-form-row--switch. -#}
    {%- if 'gv-switch' in (attr.class|default(''))|split(' ') -%}
        {%- set row_class = row_class ~ ' gv-form-row--switch' -%}
    {%- elseif 'checkbox' in block_prefixes or 'radio' in block_prefixes -%}
        {%- set row_class = row_class ~ ' gv-form-row--check' -%}
    {%- endif -%}
    {%- set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' ' ~ row_class)|trim}) -%}
    {{- parent() -}}
{%- endblock form_row %}

{%- block button_row -%}
    {%- set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' gv-form-row gv-form-row--actions')|trim}) -%}
    {{- parent() -}}
{%- endblock button_row %}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' gv-form-label')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label %}

{%- block form_widget_simple -%}
    {%- if type is not defined or type != 'hidden' -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' gv-form-control')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple %}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' gv-form-control')|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget %}

{#- An expanded choice (radios or checkboxes): each option on a line, the box before its
    label (gv-choices); with class gv-segmented, buttons side by side instead. -#}
{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' gv-choices')|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_expanded %}

{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' gv-form-control')|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed %}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({class: (help_attr.class|default('') ~ ' gv-form-help')|trim}) -%}
    {{- parent() -}}
{%- endblock form_help %}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
    <div class="gv-form-errors">
        {%- for error in errors -%}
            <span class="gv-form-error">{{ error.message }}</span>
        {%- endfor -%}
    </div>
    {%- endif -%}
{%- endblock form_errors %}

{#- A media control with its current file (MediaType): the file (a link to it when it has a
    URL, and a preview of an image), "Remove" when the field may be empty, and the input to
    upload another one. -#}
{%- block gv_media_widget -%}
    <div {{ block('widget_container_attributes') }}>
        {%- if current_file -%}
            {%- if current_file.thumbnailUrl -%}
                {#- Decorative: the name next to it says what the file is. -#}
                <img class="gv-media__preview" src="{{ current_file.thumbnailUrl }}" alt="" loading="lazy">
            {%- endif -%}
            <p class="gv-media__current">
                {%- if current_file.url -%}
                    <a class="gv-media__name" href="{{ current_file.url }}">{{ current_file.name }}</a>
                {%- else -%}
                    <span class="gv-media__name">{{ current_file.name }}</span>
                {%- endif -%}
                {%- if current_file.formattedSize -%}
                    <span class="gv-media__size">{{ current_file.formattedSize }}</span>
                {%- endif -%}
            </p>
            {%- if form.remove is defined -%}{{ form_row(form.remove) }}{%- endif -%}
        {%- endif -%}
        {{- form_widget(form.upload) -}}
        {{- form_errors(form.upload) -}}
    </div>
{%- endblock gv_media_widget %}

{#- A media control holding several files (MediaListType): the current files in their order,
    each with buttons to move it and to remove it, then the input adding files at the end. The
    buttons are hidden until the gridview-media-list controller runs: without it the list is
    kept as is. Disabled, only the list. -#}
{%- block gv_media_list_widget -%}
    <div {{ block('widget_container_attributes') }}>
        {%- if current_files is not empty -%}
            <ol class="gv-media-list__items">
                {%- for file in current_files -%}
                    {%- set name = file.name -%}
                    <li class="gv-media-list__item" data-gridview-media-list-target="item" data-id="{{ file.id }}">
                        {%- if file.thumbnailUrl -%}
                            {#- Decorative: the name next to it says what the file is. -#}
                            <img class="gv-media-list__thumbnail" src="{{ file.thumbnailUrl }}" alt="" loading="lazy">
                        {%- else -%}
                            <svg class="gv-media-list__icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M4 1.5h5L12.5 5v9.5h-8.5z M9 1.5V5h3.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
                        {%- endif -%}
                        {%- if file.url -%}
                            <a class="gv-media-list__name" href="{{ file.url }}" data-turbo="false">{{ name }}</a>
                        {%- else -%}
                            <span class="gv-media-list__name">{{ name }}</span>
                        {%- endif -%}
                        {%- if file.formattedSize -%}
                            <span class="gv-media-list__size">{{ file.formattedSize }}</span>
                        {%- endif -%}
                        {%- if not disabled -%}
                            <span class="gv-media-list__actions" data-gridview-media-list-target="actions" hidden>
                                <button type="button" class="gv-btn gv-btn-icon" data-action="gridview-media-list#up" aria-label="{{ 'media.move_up'|trans({'%name%': name}, 'GridviewBundle') }}" title="{{ 'media.move_up'|trans({'%name%': name}, 'GridviewBundle') }}">↑</button>
                                <button type="button" class="gv-btn gv-btn-icon" data-action="gridview-media-list#down" aria-label="{{ 'media.move_down'|trans({'%name%': name}, 'GridviewBundle') }}" title="{{ 'media.move_down'|trans({'%name%': name}, 'GridviewBundle') }}">↓</button>
                                <button type="button" class="gv-btn" data-action="gridview-media-list#remove" aria-label="{{ 'media.remove_named'|trans({'%name%': name}, 'GridviewBundle') }}">{{ 'media.remove'|trans({}, 'GridviewBundle') }}</button>
                            </span>
                        {%- endif -%}
                    </li>
                {%- endfor -%}
            </ol>
        {%- endif -%}
        {%- if disabled -%}
            {%- do form.kept.setRendered -%}
            {%- do form.upload.setRendered -%}
        {%- else -%}
            {{- form_widget(form.kept, {attr: {'data-gridview-media-list-target': 'kept'}}) -}}
            {{- form_widget(form.upload) -}}
            {{- form_errors(form.upload) -}}
        {%- endif -%}
    </div>
{%- endblock gv_media_list_widget %}

{#- The repeatable rows of a collection control (RowCollectionType), for the
    gridview-collection controller: each row in a fieldset with its "×", the prototype of a
    new row, "+" while the user may change them. The next free key starts after the highest
    one, so a new row never takes the key of a row already there. -#}
{%- block gv_collection_widget -%}
    {%- set next = 0 -%}
    {%- for key, row in form -%}{%- set next = max(next, key + 1) -%}{%- endfor -%}
    {%- set attr = attr|merge({class: ('gv-collection ' ~ attr.class|default(''))|trim}) -%}
    <div {{ block('widget_container_attributes') }} data-controller="gridview-collection"
         {%- if prototype is defined %}{% set entry = prototype %} data-gridview-collection-prototype-value="{{ block('gv_collection_entry')|e('html_attr') }}"{% endif %}
         data-gridview-collection-prototype-name-value="{{ prototype_name }}"
         data-gridview-collection-index-value="{{ next }}"
         data-gridview-collection-min-value="{{ collection_min }}"
         data-gridview-collection-max-value="{{ collection_max }}">
        <div class="gv-collection__rows" data-gridview-collection-target="list">
            {%- for entry in form -%}{{ block('gv_collection_entry') }}{%- endfor -%}
        </div>
        {%- if not disabled -%}
            <button type="button" class="gv-btn gv-collection__add" data-gridview-collection-target="add" data-action="gridview-collection#add">
                + {{ add_label is not null
                    ? (translation_domain is same as(false) ? add_label : add_label|trans(add_label_translation_parameters, translation_domain))
                    : 'collection.add'|trans({}, 'GridviewBundle') }}
            </button>
        {%- endif -%}
    </div>
{%- endblock gv_collection_widget %}

{#- One row of a collection: its fields, its errors and its "×". Rendered by
    gv_collection_widget for each row and for the prototype, with the row as `entry`. -#}
{%- block gv_collection_entry -%}
    <fieldset class="gv-collection__row{{ collection_inline ? ' gv-collection__row--inline' }}" data-gridview-collection-target="row">
        {{- '' -}}<div class="gv-collection__fields">{{ form_widget(entry) }}</div>
        {{- form_errors(entry) -}}
        {%- if not entry.vars.disabled -%}
            <button type="button" class="gv-btn gv-collection__remove" data-action="gridview-collection#remove" aria-label="{{ 'collection.remove'|trans({}, 'GridviewBundle') }}">×</button>
        {%- endif -%}
    </fieldset>
{%- endblock gv_collection_entry %}
