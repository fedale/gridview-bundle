{#
  Bundle's own default form theme: adds gv-* class hooks (row/label/control/
  help/errors) to Symfony's stock form_div_layout.html.twig blocks so the CRUD
  form gets proper spacing/typography without depending on Bootstrap/Tailwind.
  Host forms may use it too (twig.form_themes), inside [data-gridview] or
  [data-gv-scope]: a checkbox with class gv-switch is drawn as a switch, an
  expanded choice with class gv-segmented as buttons side by side (_forms.scss).
  Applied automatically unless a host overrides `form.theme` in its grid
  controller's viewConfig() (see AbstractCrudGridController::defaultConfig()).
#}
{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_class = 'gv-form-row' -%}
    {#- A checkbox drawn as a switch keeps its label first: gv-form-row--switch. -#}
    {%- if 'gv-switch' in (attr.class|default(''))|split(' ') -%}
        {%- set row_class = row_class ~ ' gv-form-row--switch' -%}
    {%- elseif 'checkbox' in block_prefixes or 'radio' in block_prefixes -%}
        {%- set row_class = row_class ~ ' gv-form-row--check' -%}
    {%- endif -%}
    {%- set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' ' ~ row_class)|trim}) -%}
    {{- parent() -}}
{%- endblock form_row %}

{%- block button_row -%}
    {%- set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' gv-form-row gv-form-row--actions')|trim}) -%}
    {{- parent() -}}
{%- endblock button_row %}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' gv-form-label')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label %}

{%- block form_widget_simple -%}
    {%- if type is not defined or type != 'hidden' -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' gv-form-control')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple %}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' gv-form-control')|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget %}

{#- An expanded choice (radios or checkboxes): each option on a line, the box before its
    label (gv-choices); with class gv-segmented, buttons side by side instead. -#}
{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' gv-choices')|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_expanded %}

{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' gv-form-control')|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed %}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({class: (help_attr.class|default('') ~ ' gv-form-help')|trim}) -%}
    {{- parent() -}}
{%- endblock form_help %}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
    <div class="gv-form-errors">
        {%- for error in errors -%}
            <span class="gv-form-error">{{ error.message }}</span>
        {%- endfor -%}
    </div>
    {%- endif -%}
{%- endblock form_errors %}
