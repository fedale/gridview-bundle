{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% import _self as helper %}
    {% if collector.gridCount > 0 %}
        {% set icon %}
            {{ helper.gridview_icon() }}
            <span class="sf-toolbar-value">{{ collector.gridCount }}</span>
        {% endset %}

        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>Grids rendered</b>
                <span>{{ collector.gridCount }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Rows on page</b>
                <span>{{ collector.totalRows }}</span>
            </div>
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url }) }}
    {% endif %}
{% endblock %}

{% block menu %}
    {% import _self as helper %}
    <span class="label {{ collector.gridCount == 0 ? 'disabled' }}">
        <span class="icon">{{ helper.gridview_icon() }}</span>
        <strong>Gridview</strong>
        <span class="count">
            <span>{{ collector.gridCount }}</span>
        </span>
    </span>
{% endblock %}

{% block panel %}
    {% import _self as helper %}
    <h2>Gridview</h2>

    {% if collector.gridCount == 0 %}
        <div class="empty">
            <p>No grid was rendered during this request.</p>
        </div>
    {% else %}
        <div class="metrics">
            <div class="metric">
                <span class="value">{{ collector.gridCount }}</span>
                <span class="label">Grids rendered</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.totalRows }}</span>
                <span class="label">Rows on page</span>
            </div>
        </div>

        {% for grid in collector.grids %}
            <h3>
                Grid <code>{{ grid.key }}</code>
                <small>({{ grid.responseType }} &middot; renderer: {{ grid.renderer }})</small>
            </h3>

            {# Identity & request #}
            <table>
                <thead>
                    <tr><th colspan="2">Identity &amp; request</th></tr>
                </thead>
                <tbody>
                    <tr><th>Key</th><td>{{ grid.key }}</td></tr>
                    <tr><th>Id</th><td>{{ grid.id ?? '(none)' }}</td></tr>
                    <tr><th>Route</th><td>{{ grid.route ?? '(none)' }}</td></tr>
                    <tr><th>Response type</th><td>{{ grid.responseType }}</td></tr>
                    <tr><th>Template</th><td><code>{{ grid.template }}</code></td></tr>
                    <tr><th>Theme</th><td>{{ grid.theme }}</td></tr>
                </tbody>
            </table>

            {# Renderer #}
            <table>
                <thead>
                    <tr><th colspan="2">Renderer</th></tr>
                </thead>
                <tbody>
                    <tr><th>Active</th><td>{{ grid.renderer }}</td></tr>
                    <tr>
                        <th>Available views</th>
                        <td>{{ grid.renderers is empty ? '(single view)' : grid.renderers|join(', ') }}</td>
                    </tr>
                    <tr><th>Auto filter bar</th><td>{{ helper.bool(grid.autoBar) }}</td></tr>
                    <tr>
                        <th>Filter-bar columns</th>
                        <td>{{ grid.filterBarColumns is empty ? '(none)' : grid.filterBarColumns|join(', ') }}</td>
                    </tr>
                </tbody>
            </table>

            {# Filters #}
            <table>
                <thead>
                    <tr><th colspan="2">Filters</th></tr>
                </thead>
                <tbody>
                    <tr><th>Form name</th><td><code>{{ grid.formName }}</code></td></tr>
                    <tr><th>Filter path</th><td>{{ grid.filterPath }}</td></tr>
                    <tr><th>Global search</th><td>{{ grid.globalSearch ?? '(none)' }}</td></tr>
                    <tr>
                        <th>Active filters</th>
                        <td>
                            {% if grid.filters is empty %}
                                (none)
                            {% else %}
                                {{ helper.keyvalue(grid.filters) }}
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Raw submitted params</th>
                        <td>
                            {% if grid.rawParams is empty %}
                                (none)
                            {% else %}
                                {{ helper.keyvalue(grid.rawParams) }}
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>

            {# Query #}
            <table>
                <thead>
                    <tr><th colspan="2">Query</th></tr>
                </thead>
                <tbody>
                    <tr><th>Root alias</th><td>{{ grid.query.rootAlias ?? '(unknown)' }}</td></tr>
                    <tr>
                        <th>DQL</th>
                        <td>{% if grid.query.dql %}<pre class="sf-dump">{{ grid.query.dql }}</pre>{% else %}(unavailable){% endif %}</td>
                    </tr>
                    <tr>
                        <th>SQL</th>
                        <td>{% if grid.query.sql %}<pre class="sf-dump">{{ grid.query.sql }}</pre>{% else %}(unavailable){% endif %}</td>
                    </tr>
                    <tr>
                        <th>Bound parameters</th>
                        <td>
                            {% if grid.query.params is empty %}
                                (none)
                            {% else %}
                                <table>
                                    <thead><tr><th>Name</th><th>Value</th></tr></thead>
                                    <tbody>
                                        {% for param in grid.query.params %}
                                            <tr><td>{{ param.name }}</td><td>{{ param.value }}</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>

            {# Sort #}
            <table>
                <thead>
                    <tr><th colspan="2">Sort</th></tr>
                </thead>
                <tbody>
                    <tr><th>URL sort param</th><td>{{ grid.sort.urlSort ?? '(none)' }}</td></tr>
                    <tr><th>Multi-sort</th><td>{{ grid.sort.multiSort is null ? '(unknown)' : helper.bool(grid.sort.multiSort) }}</td></tr>
                    <tr>
                        <th>Resolved orders</th>
                        <td>
                            {% if grid.sort.orders is empty %}
                                (none)
                            {% else %}
                                {{ helper.keyvalue(grid.sort.orders) }}
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>

            {# Pagination #}
            <table>
                <thead>
                    <tr><th colspan="2">Pagination</th></tr>
                </thead>
                <tbody>
                    <tr><th>Mode</th><td>{{ grid.pagination.mode }}</td></tr>
                    <tr><th>Current page</th><td>{{ grid.pagination.page }}</td></tr>
                    <tr><th>Page size</th><td>{{ grid.pagination.pageSize }}</td></tr>
                    <tr><th>Offset</th><td>{{ grid.pagination.offset }}</td></tr>
                    <tr><th>Rows on page</th><td>{{ grid.rowsOnPage }}</td></tr>
                    <tr><th>Total count</th><td>{{ grid.pagination.totalCount }}</td></tr>
                    <tr><th>Page count</th><td>{{ grid.pagination.pageCount }}</td></tr>
                    <tr>
                        <th>Page size options</th>
                        <td>{{ grid.pagination.pageSizeOptions is empty ? '(none)' : grid.pagination.pageSizeOptions|join(', ') }}</td>
                    </tr>
                </tbody>
            </table>

            {# Columns #}
            <h4>Columns ({{ grid.columns|length }})</h4>
            <table>
                <thead>
                    <tr>
                        <th>Label</th>
                        <th>Attribute</th>
                        <th>Type</th>
                        <th>In index</th>
                        <th>Sortable</th>
                        <th>Filterable</th>
                        <th>Filter bar</th>
                        <th>Exportable</th>
                        <th>Visible</th>
                        <th>Editable</th>
                    </tr>
                </thead>
                <tbody>
                    {% for column in grid.columns %}
                        <tr>
                            <td>{{ column.label ?? '' }}</td>
                            <td>{{ column.attribute ?? '' }}</td>
                            <td>{{ column.type }}</td>
                            <td>{{ helper.bool(column.activeIndex) }}</td>
                            <td>{{ helper.bool(column.sortable) }}</td>
                            <td>{{ helper.bool(column.filterable) }}</td>
                            <td>{{ column.filterBar is null ? 'auto' : helper.bool(column.filterBar) }}</td>
                            <td>{{ helper.bool(column.exportable) }}</td>
                            <td>{{ helper.bool(column.visible) }}</td>
                            <td>{{ helper.bool(column.editable) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {# Resolved options #}
            <h4>Resolved options</h4>
            <p class="help">
                Options are merged shallowly (controller <code>defaultConfig</code> &rarr;
                <code>crudOptions</code> &rarr; <code>viewConfig().options</code>); only the
                <code>crud</code> sub-key is deep-merged.
            </p>
            {{ dump(grid.options) }}
        {% endfor %}
    {% endif %}
{% endblock %}

{% macro gridview_icon() %}
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="1"/>
        <line x1="3" y1="9" x2="21" y2="9"/>
        <line x1="3" y1="15" x2="21" y2="15"/>
        <line x1="9" y1="3" x2="9" y2="21"/>
    </svg>
{% endmacro %}

{% macro bool(value) %}
    {% if value %}
        <span class="label status-success">yes</span>
    {% else %}
        <span class="label status-error">no</span>
    {% endif %}
{% endmacro %}

{% macro keyvalue(map) %}
    <table>
        <tbody>
            {% for key, value in map %}
                <tr>
                    <th>{{ key }}</th>
                    <td>{{ value is iterable ? value|json_encode : value }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endmacro %}
