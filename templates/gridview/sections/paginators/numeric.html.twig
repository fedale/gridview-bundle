{% set _currentRoute = app.request.attributes.get('_route') %}
{% set _lastPage     = pagination.pageCount %}
{% set _currentPage  = gridview.urlState.page %}
{% set turboAction   = gridview.options.behavior.useTurbo ? 'advance' : null %}

{# How many numeric pages to show on each side of the current one. #}
{% set _window       = 2 %}

{# "Go to page" select: on/off and from how many pages up to show it. #}
{% set _showSelect   = gridview.options.behavior.pagination.pageSelect %}
{% set _selectAfter  = gridview.options.behavior.pagination.pageSelectThreshold %}

{% if _lastPage > 1 %}
    {# Clamp the current page to the valid range. #}
    {% set _currentPage = max(1, min(_currentPage, _lastPage)) %}

    {# Sliding window of numeric pages around the current one. #}
    {% set _maxButtons = _window * 2 + 1 %}
    {% set _start      = max(1, _currentPage - _window) %}
    {% set _end        = min(_lastPage, _currentPage + _window) %}

    {# Keep a constant number of buttons even near the edges. #}
    {% if _end - _start + 1 < _maxButtons %}
        {% if _start == 1 %}
            {% set _end = min(_lastPage, _start + _maxButtons - 1) %}
        {% elseif _end == _lastPage %}
            {% set _start = max(1, _end - _maxButtons + 1) %}
        {% endif %}
    {% endif %}

    {# Pagination class keys (gridview.cls): component+state are themable
       (default gv-*, bootstrap5 page-item/page-link/active/disabled); the
       gv-page-* modifiers below stay as structural hooks. #}
    {% set _pItem = gridview.cls('pagination.item') %}
    {% set _pLink = gridview.cls('pagination.link') %}
    {% set _pActive = gridview.cls('pagination.active') %}
    {% set _pDisabled = gridview.cls('pagination.disabled') %}
    <nav class="gv-pagination-nav" aria-label="{{ 'pagination.aria'|trans({}, 'GridviewBundle') }}">
        <ul class="{{ gridview.cls('pagination') }}">
            {# First page #}
            <li class="{{ _pItem }} gv-page-first{{ _currentPage <= 1 ? ' ' ~ _pDisabled : '' }}">
                <a class="{{ _pLink }}"
                   href="{{ path(_currentRoute, gridview.urlState.withPage(1)) }}"
                   {% if turboAction %}data-turbo-action="{{ turboAction }}"{% endif %}
                   {{ gv_i18n_attr('pagination.first', 'aria-label') }}
                   aria-label="{{ 'pagination.first'|trans({}, 'GridviewBundle') }}">&laquo;</a>
            </li>

            {# Previous page #}
            <li class="{{ _pItem }} gv-page-prev{{ _currentPage <= 1 ? ' ' ~ _pDisabled : '' }}">
                <a class="{{ _pLink }}"
                   href="{{ path(_currentRoute, gridview.urlState.withPage(_currentPage - 1)) }}"
                   {% if turboAction %}data-turbo-action="{{ turboAction }}"{% endif %}
                   {{ gv_i18n_attr('pagination.previous', 'aria-label') }}
                   aria-label="{{ 'pagination.previous'|trans({}, 'GridviewBundle') }}">&lsaquo;</a>
            </li>

            {# Leading ellipsis #}
            {% if _start > 1 %}
                <li class="{{ _pItem }} gv-page-ellipsis {{ _pDisabled }}">
                    <span class="{{ _pLink }}">&hellip;</span>
                </li>
            {% endif %}

            {# Numeric pages #}
            {% for i in _start.._end %}
                <li class="{{ _pItem }} gv-page-number{{ i == _currentPage ? ' ' ~ _pActive : '' }}">
                    <a class="{{ _pLink }}"
                       href="{{ path(_currentRoute, gridview.urlState.withPage(i)) }}"
                       {% if turboAction %}data-turbo-action="{{ turboAction }}"{% endif %}
                       {% if i == _currentPage %}aria-current="page"{% endif %}>{{ i }}</a>
                </li>
            {% endfor %}

            {# Trailing ellipsis #}
            {% if _end < _lastPage %}
                <li class="{{ _pItem }} gv-page-ellipsis {{ _pDisabled }}">
                    <span class="{{ _pLink }}">&hellip;</span>
                </li>
            {% endif %}

            {# Next page #}
            <li class="{{ _pItem }} gv-page-next{{ _currentPage >= _lastPage ? ' ' ~ _pDisabled : '' }}">
                <a class="{{ _pLink }}"
                   href="{{ path(_currentRoute, gridview.urlState.withPage(_currentPage + 1)) }}"
                   {% if turboAction %}data-turbo-action="{{ turboAction }}"{% endif %}
                   {{ gv_i18n_attr('pagination.next', 'aria-label') }}
                   aria-label="{{ 'pagination.next'|trans({}, 'GridviewBundle') }}">&rsaquo;</a>
            </li>

            {# Last page #}
            <li class="{{ _pItem }} gv-page-last{{ _currentPage >= _lastPage ? ' ' ~ _pDisabled : '' }}">
                <a class="{{ _pLink }}"
                   href="{{ path(_currentRoute, gridview.urlState.withPage(_lastPage)) }}"
                   {% if turboAction %}data-turbo-action="{{ turboAction }}"{% endif %}
                   {{ gv_i18n_attr('pagination.last', 'aria-label') }}
                   aria-label="{{ 'pagination.last'|trans({}, 'GridviewBundle') }}">&raquo;</a>
            </li>

            {# "Go to page" select for very long lists #}
            {% if _showSelect and _lastPage >= _selectAfter %}
                <li class="{{ _pItem }} gv-page-jump"
                    data-controller="gridview-page-jump"
                    data-gridview-page-jump-turbo-value="{{ turboAction ? 'true' : 'false' }}">
                    <select class="{{ _pLink }} gv-page-select"
                            {{ gv_i18n_attr('pagination.jump', 'aria-label') }}
                            aria-label="{{ 'pagination.jump'|trans({}, 'GridviewBundle') }}"
                            data-action="change->gridview-page-jump#jump">
                        {% for i in 1.._lastPage %}
                            <option value="{{ path(_currentRoute, gridview.urlState.withPage(i)) }}"
                                    {{ i == _currentPage ? 'selected' : '' }}>
                                {{ i }} / {{ _lastPage }}
                            </option>
                        {% endfor %}
                    </select>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
