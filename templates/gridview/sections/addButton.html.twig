{% set crud = gridview.options.integration.crud|default({}) %}
{% set _addLabel = gridview.options.display.addLabel|default('Add') %}
{# App-owned label: resolve via the client domain when it is a real key,
   otherwise fall back to the system domain so the default 'Add'/'New' stays translatable. #}
{% set _addText = gv_client_label(_addLabel) ? gv_client_text(_addLabel) : _addLabel|trans({}, 'GridviewBundle') %}
{% if crud.addUrl is defined and crud.addUrl is not empty %}
    {% if (gridview.options.behavior.crudMode|default('modal')) == 'modal' %}
<a href="{{ crud.addUrl }}" class="{{ gridview.cls('btn.primary') }}" {{ gv_i18n(_addLabel) }}
   data-action="gridview-crud#open"
   data-gridview-crud-url-param="{{ crud.addUrl }}">
    <span class="{{ gridview.cls('btn.icon') }}" aria-hidden="true">+</span>{{ _addText }}
</a>
    {% else %}
{# page/custom mode: a full-page navigation. The grid renders inside a
   <turbo-frame>, so the link has to leave it — otherwise Turbo looks for a frame
   of the same id in the form page, finds none, and writes "Content missing"
   while the URL stays on the listing. Same reasoning as CrudButton::edit(). #}
<a href="{{ crud.addUrl }}" class="{{ gridview.cls('btn.primary') }}" data-turbo-frame="_top" {{ gv_i18n(_addLabel) }}>
    <span class="{{ gridview.cls('btn.icon') }}" aria-hidden="true">+</span>{{ _addText }}
</a>
    {% endif %}
{% elseif gridview.options.integration.addRoute is not empty %}
{# An app-owned route: a page of the host application, never this grid's frame. #}
<a href="{{ path(gridview.options.integration.addRoute) }}" class="{{ gridview.cls('btn.primary') }}" data-turbo-frame="_top" {{ gv_i18n(_addLabel) }}>
    <span class="{{ gridview.cls('btn.icon') }}" aria-hidden="true">+</span>{{ _addText }}
</a>
{% endif %}
