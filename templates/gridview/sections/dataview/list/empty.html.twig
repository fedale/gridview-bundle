{% if gridview.dataLoadFailed %}
    <li class="gv-list__empty gv-data-error" role="alert"><span {{ gv_i18n(gridview.options.display.dataErrorText) }}>{{ gridview.options.display.dataErrorText|trans({}, 'GridviewBundle') }}</span>{% if gridview.dataErrorDetail %} <span class="gv-data-error__detail">{{ gridview.dataErrorDetail }}</span>{% endif %}</li>
{% else %}
    <li class="gv-list__empty"><span {{ gv_i18n(gridview.options.display.emptyText) }}>{{ gridview.options.display.emptyText|trans({}, 'GridviewBundle') }}</span></li>
{% endif %}
