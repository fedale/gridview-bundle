{% set tfoot_tokens = gridview.parseLayout('tfoot') %}
{% if tfoot_tokens is not empty %}
    {# Custom tfoot content only — the default results-count summary now
       lives in the footer region ({resultsSummary}), outside the table. #}
    <tfoot>
        <tr>
            <td colspan="{{ gridview.indexColumns|length }}">
                {% for token in tfoot_tokens %}
                    {{ gridview_include(gridview, token) }}
                {% endfor %}
            </td>
        </tr>
    </tfoot>
{% endif %}
