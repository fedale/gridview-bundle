{% set footer_summaries = gridview.footerSummaries %}
{% set tfoot_tokens = gridview.parseLayout('tfoot') %}
{% if footer_summaries is not empty or tfoot_tokens is not empty %}
    <tfoot>
        {% if footer_summaries is not empty %}
            {# Per-column summary row: one cell per index column, aligned with the
               header/filter rows (including the grouping and responsive control
               columns). A column with no footer renders an empty cell. #}
            <tr class="gv-tfoot-summary-row">
                {% if gridview.isGrouped %}<td class="gv-group-ctrl" aria-hidden="true"></td>{% endif %}
                {% if gridview.options.behavior.responsive|default(false) %}<td class="gv-resp-ctrl" aria-hidden="true"></td>{% endif %}
                {% for column in gridview.indexColumns %}
                    {% set col_key = column.attribute|default('col' ~ loop.index0) %}
                    <td data-col="{{ loop.index0 }}" data-col-key="{{ col_key }}" class="gv-tfoot-cell"{% if not column.isVisible() %} style="display:none"{% endif %}>{{ footer_summaries[col_key]|default('') }}</td>
                {% endfor %}
            </tr>
        {% endif %}
        {% if tfoot_tokens is not empty %}
            {# Custom tfoot content only — the default results-count summary now
               lives in the footer region ({resultsSummary}), outside the table. #}
            <tr>
                <td colspan="{{ gridview.indexColumns|length + (gridview.isGrouped ? 1 : 0) + (gridview.options.behavior.responsive|default(false) ? 1 : 0) }}">
                    {% for token in tfoot_tokens %}
                        {{ gridview_include(gridview, token) }}
                    {% endfor %}
                </td>
            </tr>
        {% endif %}
    </tfoot>
{% endif %}
