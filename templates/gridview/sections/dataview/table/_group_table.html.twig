{# Default child presentation: a nested table of the related records.

   Overridable per grid via the grouping `template` option. A custom template
   receives:
     - row:          the parent Row (its `children` are the child Rows)
     - childColumns:  the resolved child ColumnInterface[] (grouping `columns`)
     - gridview:      the grid, for helpers/labels

   Render child cells with `column.render(child, index)` to reuse the column
   pipeline, or lay the data out however you like from `child.data`. #}
{% if row.children is empty %}
    <div class="gv-group-empty">No related records</div>
{% else %}
    <table class="gv-group-table">
        <thead>
            <tr>
                {% for column in childColumns %}
                <th>{{ column.renderHeader(gv_header_label(column.label))|raw }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for child in row.children %}
            <tr {{ child.attr|options }}>
                {% for column in childColumns %}
                <td>{{ column.render(child, loop.index0) }}</td>
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
