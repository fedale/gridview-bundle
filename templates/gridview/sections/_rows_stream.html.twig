{#
  "Rows only" response of the infinite scroll. Serve with
  Content-Type: text/vnd.turbo-stream.html (see Gridview::renderGrid).
  Appends the requested page's rows to the <tbody> and replaces the infinite
  section, which reports the new current page and the URL of the next one.
#}
<turbo-stream action="append" target="gv-tbody-{{ gridview.key }}">
    <template>
        {% include '@FedaleGridview/gridview/sections/dataview/table/_rows.html.twig' %}
    </template>
</turbo-stream>
<turbo-stream action="replace" target="gv-infinite-{{ gridview.key }}">
    <template>
        {% include '@FedaleGridview/gridview/sections/paginators/infinite.html.twig' %}
    </template>
</turbo-stream>
